// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  COACH
  ADMIN
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
  CANCELLED
}

enum LessonStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  COURSE_ENROLLMENT
  LESSON_COMPLETED
  CERTIFICATE_EARNED
  COACHING_REMINDER
  PAYMENT_CONFIRMED
  SYSTEM_ANNOUNCEMENT
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  USER_APPROVED
  USER_REJECTED
  USER_BANNED
  ROLE_CHANGED
  WALLET_TOPUP
  SESSION_BOOKED
  SESSION_CONFIRMED
  SESSION_CANCELLED
}

enum MessageType {
  TEXT
  FILE
  IMAGE
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  role              UserRole  @default(USER)
  isActive          Boolean   @default(true)
  accountType       String    @default("STUDENT") // STUDENT | INSTRUCTOR | CONSULTANT | ADMIN
  status            String    @default("ACTIVE")  // ACTIVE | PENDING | REJECTED | BANNED
  cvUrl             String?
  bio               String?
  experience        Int?
  speciality        String?
  linkedinUrl       String?
  hourlyRate        Float?
  meetingMethod     String?   // ZOOM | GOOGLE_MEET | BOTH
  googleId          String?   @unique
  provider          String    @default("local")
  stripeCustomerId  String?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectedReason    String?
  lastSeenAt        DateTime?
  
  // Identity verification fields
  idVerificationStatus String    @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  idFrontUrl          String?
  idBackUrl          String?
  idVerifiedAt      DateTime?
  idRejectedReason String?
  isVerified        Boolean   @default(false)
  walletBalance     Float     @default(0)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // Relations
  profile              UserProfile?
  subscriptions        Subscription[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  careerAssessments    CareerAssessment[]
  enrollments          Enrollment[]
  lessonProgress       LessonProgress[]
  certificates         Certificate[]
  payments             Payment[]
  coachingSessions     CoachingSession[]
  coachReviews         CoachReview[]
  sentMessages         ChatMessage[]      @relation("SentMessages")
  receivedMessages     ChatMessage[]      @relation("ReceivedMessages")
  notifications        Notification[]
  adminLogs            AdminLog[]
  uploadedFiles        UploadedFile[]
  fileShares           FileShare[]
  deviceTokens         DeviceToken[]
  analyticsEvents      AnalyticsEvent[]
  quizAttempts         QuizAttempt[]
  coachProfile         Coach?
  assessmentSessions   AssessmentSession[]
  userCareerPath       UserCareerPath?
  studentSessions      ConsultingSession[] @relation("StudentSessions")
  consultantSessions   ConsultingSession[] @relation("ConsultantSessions")
  instructorCourses    Course[]            @relation("InstructorCourses")
  cart                 Cart?
  conversations        Conversation[]
  givenRatings         Rating[]            @relation("GivenRatings")
  receivedRatings      Rating[]            @relation("ConsultantRatings")
  activities           UserActivity[]
  walletTransactions   WalletTransaction[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([accountType])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  firstName         String
  lastName          String
  phone            String?
  dateOfBirth      DateTime?
  gender           Gender?
  nationality      String?
  country          String?
  city             String?
  avatar           String?
  bio              String?
  linkedinUrl      String?
  timezone         String    @default("UTC")
  language         String    @default("en")
  speciality       String?
  yearsExperience  Int       @default(0)
  qualifications   String[]  @default([])
  consultingAreas  String[]  @default([])
  sessionPrice     Float     @default(0)
  sessionDuration Int       @default(60)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_profiles")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  ipAddress  String?
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model CareerPath {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleEn       String
  titleAr       String
  descriptionEn String
  descriptionAr String
  skills        String[] // JSON array of skill names
  salaryRangeEn String // JSON object with min, max, currency
  salaryRangeAr String // JSON object with min, max, currency
  jobTitlesEn   String[] // JSON array of job titles
  jobTitlesAr   String[] // JSON array of job titles
  demandLevel   String // HIGH, MEDIUM, LOW
  icon          String?
  color         String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  courses           Course[]
  careerAssessments CareerAssessment[]

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@map("career_paths")
}

model CareerAssessment {
  id           String           @id @default(cuid())
  userId       String
  careerPathId String
  status       AssessmentStatus @default(IN_PROGRESS)
  score        Int?
  results      Json? // Detailed assessment results
  startedAt    DateTime         @default(now())
  completedAt  DateTime?
  expiresAt    DateTime         @default(dbgenerated("(now() + interval '7 days')"))
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerPath CareerPath           @relation(fields: [careerPathId], references: [id])
  questions  AssessmentQuestion[]

  @@index([userId])
  @@index([careerPathId])
  @@index([status])
  @@index([expiresAt])
  @@map("career_assessments")
}

model AssessmentQuestion {
  id             String   @id @default(cuid())
  assessmentId   String
  questionTextEn String
  questionTextAr String
  questionType   String // MULTIPLE_CHOICE, SCALE, TEXT
  options        Json? // JSON array of options for multiple choice
  correctAnswer  String?
  userAnswer     String?
  points         Int      @default(1)
  order          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  assessment CareerAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([order])
  @@map("assessment_questions")
}

model Category {
  id       String    @id @default(cuid())
  nameAr   String
  nameEn   String
  slug     String    @unique
  icon     String?
  parentId String?
  parent   Category? @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")

  courses Course[]

  @@map("categories")
}

model Course {
  id            String       @id @default(cuid())
  slug          String       @unique
  careerPathId  String?
  instructorId  String?
  categoryId    String?
  titleEn       String
  titleAr       String?
  descriptionEn String?
  descriptionAr String?
  thumbnail     String?
  previewVideo  String?
  price         Float        @default(0)
  currency      String       @default("USD")
  duration      Int?
  level         String       @default("BEGINNER")
  tags          String[]     @default([])
  careerPaths  String[]     @default([])
  status        CourseStatus @default(DRAFT)
  isFeatured    Boolean      @default(false)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  careerPath   CareerPath?    @relation(fields: [careerPathId], references: [id])
  category     Category?      @relation(fields: [categoryId], references: [id])
  instructor   User?          @relation("InstructorCourses", fields: [instructorId], references: [id])
  modules      CourseModule[]
  sections     Section[]
  enrollments  Enrollment[]
  certificates Certificate[]
  payments     Payment[]
  cartItems    CartItem[]
  ratings      Rating[]
  bundles     BundleCourse[]

  @@index([status])
  @@index([isFeatured])
  @@index([sortOrder])
  @@index([instructorId])
  @@index([categoryId])
  @@index([careerPathId, status])
}

model CourseBundle {
  id          String   @id @default(cuid())
  titleEn      String
  titleAr     String
  description String?
  price       Float    @default(0)
  discount    Float    @default(0)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bundles     BundleCourse[]

  @@index([isActive])
  @@index([isFeatured])
  @@index([sortOrder])
}

model BundleCourse {
  id        String      @id @default(cuid())
  bundleId  String
  courseId  String
  order    Int         @default(0)
  bundle   CourseBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  course   Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@index([courseId])
  @@unique([bundleId, courseId])
}

model Section {
  id       String   @id @default(cuid())
  title    String
  order    Int      @default(0)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId])
  @@map("sections")
}

model CourseModule {
  id            String   @id @default(cuid())
  courseId      String
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  sortOrder     Int      @default(0)
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@index([sortOrder])
  @@index([isPublished])
  @@map("course_modules")
}

model Lesson {
  id            String   @id @default(cuid())
  moduleId      String?
  sectionId     String?
  title         String
  titleAr       String?
  description   String?
  descriptionAr String?
  content       Json? // Rich content
  type          String   @default("VIDEO") // VIDEO | FILE | TEXT
  videoUrl      String?
  videoDuration Int? // in seconds
  fileUrl       String?
  fileName      String?
  fileSize      Int?
  isFree        Boolean  @default(false)
  order         Int      @default(0)
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  module       CourseModule?    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  section      Section?         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  videoContent VideoContent?
  quiz         Quiz?
  progress     LessonProgress[]

  @@index([moduleId])
  @@index([sectionId])
  @@index([order])
  @@index([isPublished])
  @@map("lessons")
}

model VideoContent {
  id          String   @id @default(cuid())
  lessonId    String   @unique
  streamId    String   @unique
  uploadUrl   String? // Temporary upload URL
  playbackUrl String? // Signed playback URL
  thumbnail   String?
  duration    Int? // Duration in seconds
  status      String // UPLOADING, PROCESSING, READY, ERROR
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([streamId])
  @@index([status])
  @@map("video_content")
}

model Quiz {
  id            String   @id @default(cuid())
  lessonId      String?  @unique
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  passingScore  Int      @default(70)
  timeLimit     Int? // Time limit in minutes
  maxAttempts   Int      @default(3)
  sortOrder     Int      @default(0)
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  lesson    Lesson?        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([lessonId])
  @@index([isPublished])
  @@map("quizzes")
}

model QuizQuestion {
  id             String   @id @default(cuid())
  quizId         String
  questionTextEn String
  questionTextAr String
  questionType   String // MULTIPLE_CHOICE, TRUE_FALSE, TEXT
  options        Json? // JSON array of options
  correctAnswer  String
  points         Int      @default(1)
  order          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([order])
  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  score       Int
  maxScore    Int
  passed      Boolean
  answers     Json // User's answers
  startedAt   DateTime @default(now())
  completedAt DateTime
  attemptNum  Int

  // Relations
  quiz Quiz @relation(fields: [quizId], references: [id])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@index([passed])
  @@map("quiz_attempts")
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  progress    Float            @default(0) // Percentage 0-100
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  expiresAt   DateTime?

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model LessonProgress {
  id          String       @id @default(cuid())
  userId      String
  lessonId    String
  status      LessonStatus @default(NOT_STARTED)
  progress    Float        @default(0) // Percentage 0-100
  timeSpent   Int          @default(0) // Time spent in seconds
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([status])
  @@index([userId, lessonId, status])
  @@map("lesson_progress")
}

model Certificate {
  id             String    @id @default(cuid())
  userId         String
  courseId       String
  serialNumber   String    @unique
  certificateUrl String // S3 URL
  qrCodeUrl      String // S3 URL
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime?

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([serialNumber])
  @@map("certificates")
}

model Coach {
  id           String   @id @default(cuid())
  userId       String   @unique
  bioEn        String
  bioAr        String
  specialties  String[] // JSON array of specialties
  experience   Int // Years of experience
  hourlyRate   Float
  currency     String   @default("USD")
  availability Json // JSON object with availability schedule
  isVerified   Boolean  @default(false)
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user             User              @relation(fields: [userId], references: [id])
  coachingSlots    CoachingSlot[]
  coachingSessions CoachingSession[]
  reviews          CoachReview[]

  @@index([userId])
  @@index([isVerified])
  @@index([rating])
  @@map("coaches")
}

model CoachingSlot {
  id        String   @id @default(cuid())
  coachId   String
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)
  price     Float?
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  coach    Coach             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  sessions CoachingSession[]

  @@index([coachId])
  @@index([startTime])
  @@index([isBooked])
  @@map("coaching_slots")
}

model CoachingSession {
  id            String        @id @default(cuid())
  coachId       String
  userId        String
  slotId        String
  zoomMeetingId String?
  zoomJoinUrl   String?
  status        SessionStatus @default(SCHEDULED)
  notes         String?
  recordingUrl  String?
  startTime     DateTime // Added startTime field
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  coach   Coach         @relation(fields: [coachId], references: [id])
  user    User          @relation(fields: [userId], references: [id])
  slot    CoachingSlot  @relation(fields: [slotId], references: [id])
  reviews CoachReview[]

  @@index([coachId])
  @@index([userId])
  @@index([slotId])
  @@index([status])
  @@index([startTime])
  @@map("coaching_sessions")
}

model CoachReview {
  id        String   @id @default(cuid())
  coachId   String
  userId    String
  sessionId String
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  coach   Coach           @relation(fields: [coachId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session CoachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([coachId])
  @@index([userId])
  @@index([sessionId])
  @@map("coach_reviews")
}

model Payment {
  id             String   @id @default(cuid())
  userId         String
  courseId       String?
  amount         Float
  currency       String   @default("SAR")
  method         String   @default("STRIPE_CARD")
  status         String   @default("PENDING")
  transactionId  String?  @unique
  stripeIntentId String?
  description    String?
  itemType       String?
  itemId         String?
  completedAt    DateTime?
  refundedAt     DateTime?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user   User    @relation(fields: [userId], references: [id])
  course Course? @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([method])
  @@index([transactionId])
  @@index([userId, status])
  @@map("payments")
}

model ChatMessage {
  id         String      @id @default(cuid())
  senderId   String
  receiverId String
  sessionId  String? // Coaching session ID if applicable
  content    String
  type       MessageType @default(TEXT)
  fileUrl    String?
  isRead     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relations
  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([sessionId])
  @@index([isRead])
  @@index([createdAt])
  @@map("chat_messages")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  titleEn   String
  titleAr   String
  contentEn String
  contentAr String
  data      Json? // Additional notification data
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String // CREATE, UPDATE, DELETE, LOGIN, etc.
  resource   String // User, Course, Coach, etc.
  resourceId String?
  details    Json? // Action details
  ipAddress  String?
  userAgent  String?
  createdAt DateTime @default(now())

  // Relations
  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("admin_logs")
}

model UploadedFile {
  id           String   @id @default(cuid())
  userId       String
  fileName     String
  originalName String
  mimeType     String
  size         Int
  fileType     String // image, video, document
  key          String // S3 key
  url          String // S3 URL
  isPublic     Boolean  @default(false)
  folder       String   @default("general")
  metadata     Json? // Additional metadata
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares FileShare[]

  @@index([userId])
  @@index([fileType])
  @@index([isPublic])
  @@index([folder])
  @@index([createdAt])
  @@map("uploaded_files")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String // ios, android, web
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
  @@index([isActive])
  @@map("device_tokens")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String? // Can be anonymous
  event      String // Event name
  properties Json? // Event properties
  sessionId  String? // Session ID for tracking
  ipAddress  String?
  userAgent  String?
  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([event])
  @@index([sessionId])
  @@index([createdAt])
  @@map("analytics_events")
}

model FileShare {
  id            String   @id @default(cuid())
  fileId        String
  shareId       String   @unique
  userId        String // Who created the share
  expiresAt     DateTime
  password      String? // Hashed password
  downloadLimit Int? // Download limit
  downloadCount Int      @default(0)
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())

  // Relations
  file UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])

  @@index([fileId])
  @@index([shareId])
  @@index([expiresAt])
  @@map("file_shares")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  plan      String
  status    String   @default("ACTIVE")
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
}

model UserCareerPath {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  pathId       String
  pathTitle    String
  pathCategory String
  aiRecommended Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("user_career_paths")
}

model AssessmentSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  answers     Json      @default("[]")
  report      Json?
  status      String    @default("IN_PROGRESS")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([status])
  @@map("assessment_sessions")
}

// ════════════════════════════════════════════════════════
// ✅ SiteSettings - UPDATED COLORS (Purple + White Theme)
// ════════════════════════════════════════════════════════
model SiteSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("DeveWay")
  
  // ✅ Updated: Purple theme (was blue #5120c8)
  primaryColor    String   @default("#5120c8")
  
  // ✅ Updated: Clean white for light mode (was #0d0d0d / #0d0d0d)
  backgroundColor String   @default("#FFFFFF")
  
  // ✅ Updated: Purple buttons (was blue #5120c8)
  buttonColor     String   @default("#5120c8")
  
  logoUrl         String?
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}

model ConsultingSession {
  id            String    @id @default(cuid())
  studentId     String
  consultantId  String
  student       User      @relation("StudentSessions", fields: [studentId], references: [id])
  consultant    User      @relation("ConsultantSessions", fields: [consultantId], references: [id])
  scheduledAt   DateTime
  duration     Int       @default(60)
  meetingMethod String    @default("ZOOM")
  meetingLink  String?
  topic        String?
  notes        String?
  status       String    @default("PENDING")
  price        Float     @default(0)
  paymentStatus String   @default("UNPAID")
  paymentId    String?
  cancelReason String?
  completedAt  DateTime?
  cancelledAt  DateTime?
  proposedAt   DateTime?
  proposedTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([studentId])
  @@index([consultantId])
  @@index([status])
  @@map("consulting_sessions")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  adminId    String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Conversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("محادثة جديدة")
  context   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId])
  @@map("conversations")
}

model AiMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String       @db.Text
  tokens         Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("ai_messages")
}

model Rating {
  id           String   @id @default(cuid())
  userId       String
  courseId     String?
  consultantId String?
  value        Int      // 1-5
  comment      String?
  createdAt    DateTime @default(now())
  user         User     @relation("GivenRatings", fields: [userId], references: [id])
  course       Course?  @relation(fields: [courseId], references: [id])
  consultant   User?    @relation("ConsultantRatings", fields: [consultantId], references: [id])

  @@unique([userId, courseId])
  @@unique([userId, consultantId])
  @@map("ratings")
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("user_activities")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([cartId, courseId])
  @@index([cartId])
  @@index([courseId])
  @@map("cart_items")
}

model WalletTransaction {
  id                    String   @id @default(cuid())
  userId                String
  type                  String   // TOPUP | PAYMENT | REFUND
  amount                Float
  description           String?
  status                String   @default("SUCCESS")
  stripePaymentIntentId String?
  courseId              String?
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("wallet_transactions")
}