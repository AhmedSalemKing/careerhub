  courseId String [not null]
  course Course [not null]
  addedAt DateTime [default: `now()`, not null]

  indexes {
    (cartId, courseId) [unique]
  }
}

Table wallet_transactions {
  id String [pk]
  userId String [not null]
  type String [not null]
  amount Float [not null]
  description String
  status String [not null, default: 'SUCCESS']
  stripePaymentIntentId String
  courseId String
  createdAt DateTime [default: `now()`, not null]
  user users [not null]
}

Table exchange_rates {
  id String [pk]
  fromCurrency String [not null]
  toCurrency String [not null]
  rate Float [not null]
  updatedAt DateTime [not null]
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (fromCurrency, toCurrency) [unique]
  }
}

Table LiveSession {
  id String [pk]
  courseId String [not null]
  channelName String [unique]
  instructorId String [not null]
  status LiveSessionStatus [not null, default: 'SCHEDULED']
  isLive Boolean [not null, default: false]
  dailyRoomName String
  dailyRoomUrl String
  recordingUrl String
  startedAt DateTime
  endedAt DateTime
  durationMinutes Int [not null, default: 0]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  recording LiveRecording
}

Table LiveRecording {
  id String [pk]
  liveSessionId String [unique, not null]
  status RecordingStatus [not null, default: 'PENDING']
  resourceId String
  sid String [unique]
  b2Key String
  bunnyVideoId String
  lastError String
  retryCount Int [not null, default: 0]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  liveSession LiveSession [not null]
}

Table WebhookEvent {
  id String [pk]
  source String [not null]
  eventType String [not null]
  externalId String
  payload Json [not null]
  processed Boolean [not null, default: false]
  processedAt DateTime
  createdAt DateTime [default: `now()`, not null]
}

Table compass_versions {
  id String [pk]
  version String [unique, not null]
  isActive Boolean [not null, default: false]
  publishedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  stages compass_stages [not null]
  questions compass_questions [not null]
  sessions compass_sessions [not null]
}

Table compass_stages {
  id String [pk]
  versionId String [not null]
  stageNumber Int [not null]
  titleAr String [not null]
  titleEn String [not null]
  version compass_versions [not null]
  questions compass_questions [not null]

  indexes {
    (versionId, stageNumber) [unique]
  }
}

Table compass_questions {
  id String [pk]
  versionId String [not null]
  stageId String [not null]
  dimension CompassDimension [not null]
  type CompassQuestionType [not null]
  textAr String [not null]
  textEn String [not null]
  hintAr String
  hintEn String
  isBaseline Boolean [not null, default: true]
  order Int [not null]
  minAnswers Int
  maxAnswers Int
  maxFollowUpDepth Int [not null, default: 1]
  version compass_versions [not null]
  stage compass_stages [not null]
  options compass_options [not null]
  triggersRules compass_follow_up_rules [not null]
  asFollowUp compass_follow_up_rules [not null]
  answers compass_answers [not null]
  sessionQuestions compass_session_questions [not null]
}

Table compass_options {
  id String [pk]
  questionId String [not null]
  textAr String [not null]
  textEn String [not null]
  order Int [not null]
  question compass_questions [not null]
  followUpRules compass_follow_up_rules [not null]
}

Table compass_follow_up_rules {
  id String [pk]
  triggerQuestionId String [not null]
  triggerOptionId String
  triggerCondition String
  followUpQuestionId String [not null]
  dimension CompassDimension [not null]
  reasonAr String [not null]
  reasonEn String [not null]
  priority Int [not null, default: 0]
  triggerQuestion compass_questions [not null]
  triggerOption compass_options
  followUpQuestion compass_questions [not null]
}

Table compass_sessions {
  id String [pk]
  userId String [not null]
  versionId String [not null]
  status CompassSessionStatus [not null, default: 'IN_PROGRESS']
  currentStage Int [not null, default: 1]
  startedAt DateTime [default: `now()`, not null]
  completedAt DateTime
  expiresAt DateTime [not null]
  user users [not null]
  version compass_versions [not null]
  answers compass_answers [not null]
  sessionQuestions compass_session_questions [not null]
  dimensionEvidence compass_dimension_evidence
  report compass_reports
}

Table compass_session_questions {
  id String [pk]
  sessionId String [not null]
  questionId String [not null]
  presentedOrder Int [not null]
  status CompassQuestionStatus [not null, default: 'PENDING']
  branchingReason String
  followUpDepth Int [not null, default: 0]
  session compass_sessions [not null]
  question compass_questions [not null]

  indexes {
    (sessionId, questionId) [unique]
  }
}

Table compass_answers {
  id String [pk]
  sessionId String [not null]
  questionId String [not null]
  selectedOptionIds String[] [not null]
  rankingOrder Json
  textValue String
  ratingValue Int
  isFollowUp Boolean [not null, default: false]
  followUpDepth Int [not null, default: 0]
  answeredAt DateTime [default: `now()`, not null]
  session compass_sessions [not null]
  question compass_questions [not null]

  indexes {
    (sessionId, questionId) [unique]
  }
}

Table compass_dimension_evidence {
  id String [pk]
  sessionId String [unique, not null]
  interests Int
  skills Int
  behavioralIndicators Int
  motivation Int
  workPreferences Int
  marketReadiness Int
  careerFitScore Int
  confidence Int
  scoringVersion String
  evidenceFindings Json [not null, default: '{}']
  skillDiscrepancies Json [not null, default: '[]']
  session compass_sessions [not null]
}

Table compass_reports {
  id String [pk]
  sessionId String [unique, not null]
  profileSummaryAr String
  profileSummaryEn String
  candidatePaths Json [not null, default: '[]']
  strengthsAr Json [not null, default: '[]']
  strengthsEn Json [not null, default: '[]']
  skillGapsAr Json [not null, default: '[]']
  skillGapsEn Json [not null, default: '[]']
  experienceGapsAr Json [not null, default: '[]']
  experienceGapsEn Json [not null, default: '[]']
  learningRoadmapAr Json [not null, default: '{}']
  learningRoadmapEn Json [not null, default: '{}']
  limitations String
  aiNarrativeAr String
  aiNarrativeEn String
  generatedAt DateTime [default: `now()`, not null]
  session compass_sessions [not null]
}

Table tracks {
  id String [pk]
  slug String [unique, not null]
  nameAr String [not null]
  nameEn String [not null]
  descAr String [not null]
  descEn String [not null]
  weeks Int [not null]
  level String [not null]
  levelEn String [not null]
  languages String [not null]
  coverImage String
  sessionPrice Float [note: 'optional fixed session price (SAR); when null it is derived from the cheapest matching consultant']
  speciality String [note: 'matches UserProfile.speciality so consultants can be listed on the track']
  visionDescKSA String
  visionDescEG String
  vision2030 String[] [not null]
  skills String[] [not null]
  skillsEn String[] [not null]
  jobs Json [not null, default: '[]', note: '[{ titleAr, titleEn, descAr, descEn, salaryMinEG, salaryMaxEG, salaryMinKSA, salaryMaxKSA, vision: ["KSA"|"EG"] }]']
  courses Json [not null, default: '[]', note: '[{ order, titleAr, titleEn, type, typeEn, weeks, provider, language, courseId? }]']
  freeItemsAr String[] [not null]
  freeItemsEn String[] [not null]
  isActive Boolean [not null, default: true]
  country String [not null, default: 'BOTH']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: 'Learning tracks shown on the home page and /careers (managed from the admin panel).'
}

Table packages {
  id String [pk]
  pathId String [not null, note: 'id of the Track (kind TRACK) or CareerPath (kind CAREER_PATH) the bundle belongs to']
  pathKind String [not null, default: 'TRACK']
  courseIds String[] [not null]
  originalPrice Float
  finalPrice Float [not null]
  notes String
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: 'A priced bundle of courses sold for one learning track (or career path); created from the admin "إنشاء باكدج" form.'
}

Enum UserRole {
  USER
  COACH
  ADMIN
  SUPER_ADMIN
}

Enum Gender {
  MALE
  FEMALE
  OTHER
}

Enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

Enum LectureStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

Enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

Enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
  CANCELLED
}

Enum LessonStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

Enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

Enum NotificationType {
  COURSE_ENROLLMENT
  LESSON_COMPLETED
  CERTIFICATE_EARNED
  COACHING_REMINDER
  PAYMENT_CONFIRMED
  SYSTEM_ANNOUNCEMENT
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  USER_APPROVED
  USER_REJECTED
  USER_BANNED
  ROLE_CHANGED
  WALLET_TOPUP
  SESSION_BOOKED
  SESSION_CONFIRMED
  SESSION_CANCELLED
  LIVE_STARTED
  LIVE_ENDED
}

Enum MessageType {
  TEXT
  FILE
  IMAGE
}

Enum LiveSessionStatus {
  SCHEDULED
  STARTING
  LIVE
  ENDING
  ENDED
}

Enum RecordingStatus {
  PENDING
  STARTING
  RECORDING
  STOPPING
  PROCESSING
  UPLOADING
  READY
  FAILED
  NEEDS_ATTENTION
}

Enum CompassDimension {
  CONTEXT
  INTERESTS
  SKILLS
  BEHAVIORAL_INDICATORS
  MOTIVATION
  WORK_PREFERENCES
  MARKET_READINESS
}

Enum CompassQuestionType {
  SINGLE_CHOICE
  MULTI_SELECT
  RANKING
  RATING_SCALE
  SHORT_TEXT
  SCENARIO
  PRACTICAL_MINI
}

Enum CompassSessionStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
  ABANDONED
}

Enum CompassQuestionStatus {
  PENDING
  PRESENTED
  ANSWERED
  SKIPPED
}

